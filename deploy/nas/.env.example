# Dedicated root hostname. Add it to local DNS or every client hosts file.
NAS_HOSTNAME=harness.local
NAS_NAME=Home NAS
HTTPS_PORT=443

# Host paths. Keep these outside the application source checkout.
CONFIG_PATH=./data/config
WORKSPACES_PATH=./data/workspaces

# Container user matching the owner of the mounted host directories.
PUID=1000
PGID=1000
DEVICE_LIFETIME_DAYS=90
